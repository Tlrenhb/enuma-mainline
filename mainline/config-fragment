# Overrides applied on top of armbian's linux-sm8250-edge.config.
# Goal: a kernel that can show something on the panel and talk over USB-C
# without any initramfs modules or extra firmware.

CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_DRM_PANEL_NOVATEK_NT36523=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8866=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_GENI_QCOM=y
CONFIG_TOUCHSCREEN_NT36523_SPI=y

# The boot header cmdline is empty on this device, so bake the probe cmdline
# into the kernel and let it override whatever ABL/vendor_boot supplies.
CONFIG_CMDLINE="console=tty0 rdinit=/init root=/dev/ram0 rw loglevel=8 ignore_loglevel panic=30 fbcon=nodefer"
CONFIG_CMDLINE_FORCE=y

CONFIG_KERNEL_GZIP=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_WERROR=n

CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_SNPS_FEMTO_V2=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y

# CONFIG_KERNEL_LZ4 is not set
# CONFIG_KERNEL_LZMA is not set
# CONFIG_KERNEL_XZ is not set
# CONFIG_KERNEL_ZSTD is not set